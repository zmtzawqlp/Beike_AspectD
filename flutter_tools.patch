+++ b/packages/flutter_tools/lib/src/aop/hook_factory.dart
@@ -0,0 +1,68 @@
+import 'dart:io';
+
+import '../artifacts.dart';
+import '../base/common.dart';
+import '../build_info.dart';
+import '../globals.dart';
+
+enum CommandType4Aop { bundle, aot, snapshot }
+
+class HookFactory {
+  static Future<void> hook(
+    String productDirPath,
+    String executorPath,
+    BuildMode buildMode,
+    CommandType4Aop type,
+  ) async {
+    if (!fs.file(executorPath).existsSync()) {
+      return;
+    }
+
+    String inputPath = switch (type) {
+      CommandType4Aop.bundle => _getBundleInputPath(productDirPath),
+      CommandType4Aop.aot => _getAotInputPath(productDirPath),
+      CommandType4Aop.snapshot => _getSnapshotInputPath(productDirPath),
+    };
+
+    if (!inputPath.startsWith(fs.currentDirectory.path)) {
+      inputPath = fs.path.join(fs.currentDirectory.path, inputPath);
+    }
+    if (!fs.file(inputPath).existsSync()) {
+      return;
+    }
+
+    final String outputPath = '$inputPath.${type.name}.result.dill';
+    final String engineDartPath = artifacts!.getArtifactPath(Artifact.engineDartBinary);
+
+    final List<String> command = <String>[
+      engineDartPath,
+      executorPath,
+      '--input',
+      inputPath,
+      '--output',
+      outputPath,
+      if (buildMode != BuildMode.release) ...<String>[
+        '--sdk-root',
+        '${fs.file(artifacts!.getArtifactPath(Artifact.platformKernelDill)).parent.path}${fs.path.separator}',
+      ],
+    ];
+
+    final ProcessResult result = await processManager.run(command);
+    if (result.exitCode != 0) {
+      throwToolExit('hook by aop terminated unexpectedly in ${type.name}: ${result.stderr}');
+    }
+
+    final File inputFile = fs.file(inputPath);
+    if (inputFile.existsSync()) {
+      inputFile.deleteSync();
+    }
+
+    fs.file(outputPath).renameSync(inputPath);
+  }
+
+  static String _getBundleInputPath(String assetsDir) => fs.path.join(assetsDir, 'kernel_blob.bin');
+
+  static String _getAotInputPath(String productDirPath) => fs.path.join(productDirPath, 'app.dill');
+
+  static String _getSnapshotInputPath(String path) => path;
+}
